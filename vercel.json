{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash ota/build.sh",
  "outputDirectory": "ota/deploy",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/vendor-assets/:path*", "destination": "https://assets.opendaw.studio/:path*" },
    { "source": "/vendor-api/:path*", "destination": "https://api.opendaw.studio/:path*" }
  ]
}
